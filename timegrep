# handle long lines, but put a limit them
DEFAULT_READ_BUFFSIZE = int(4096)
# arbitrary, the optimal value is highly dependent on the structure of the file
DEFAULT_REWIND_OFFSET = int(100)
# arbitrary, allow for a VERY large file, but stop it if it runs away
DEFAULT_MAX_ITERATION = int(75)

MATCH_STR  = ""

logformat_list = []
# W3C Extended
# pylint: disable-next=line-too-long
logformat_list.append({'regexp': r"(?P<YEAR>[0-9]{4})\-(?P<MONTH>[0-9]{2})\-(?P<DAY>[0-9]{2}) (?P<HOURS>[0-9]{2}):(?P<MINUTES>[0-9]{2}):(?P<SECONDS>[0-9]{2})",
                       'name':"W3C Extended",
                       'description':"%Y-%m-%d %H:%M:%S"})
# Syslog
