logformat_list.append({'regexp':r"(?P<MONTH_NAME>[a-zA-Z]{3}) {1,2}(?P<DAY>[0-9]{1,2}) (?P<HOURS>[0-9]{2}):(?P<MINUTES>[0-9]{2}):(?P<SECONDS>[0-9]{2})",
                       'name':"Syslog",
                       'description':"%b %d %H:%M:%S"})
# NSCA Common
# pylint: disable-next=line-too-long
logformat_list.append({'regexp':r"(?P<origin>\d+\.\d+\.\d+\.\d+) (?P<identd>-|\w*) (?P<auth>-|\w*) \[(?P<DAY>[0-9]{1,2})/(?P<MONTH_NAME>[a-zA-Z]{3})/(?P<YEAR>[0-9]{4}):(?P<HOURS>[0-9]{2}):(?P<MINUTES>[0-9]{2}):(?P<SECONDS>[0-9]{2}) (?P<tz>[\-\+]?\d\d\d\d)\]",
                       'name':"NSCA Common",
                       'description':"host rfc931 username [%d/%b/%Y:%H:%M:%S +TZ]"})
# Bind8
# pylint: disable-next=line-too-long
logformat_list.append({'regexp':r"(?P<DAY>[0-9]{1,2})\-(?P<MONTH_NAME>[a-zA-Z]{3})\-(?P<YEAR>[0-9]{4}) (?P<HOURS>[0-9]{2}):(?P<MINUTES>[0-9]{2}):(?P<SECONDS>[0-9]{2})\.",
                       'name':"Bind8",
                       'description':"%d-%b-%Y %H:%M:%S."})
# Nginx Error
