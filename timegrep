def _no_traceback_excepthook(exc_type, exc_val, traceback):
    """
    Allow to disable python traceback message when doing CTRL+C
    https://stackoverflow.com/a/74525682
    """
    if isinstance(exc_val, KeyboardInterrupt):
        return
    sys.__excepthook__(exc_type, exc_val, traceback)

sys.excepthook = _no_traceback_excepthook

def debug_msg(msg_txt: str, msg_level = 0):
    """
    Allow to show debug messages depending on the debug level
    """
    if DEBUG_LEVEL > msg_level:
        print(msg_txt)

# Function to read lines from file and extract the date and time
def getdata(date_format: str, file_handle: TextIO,
            read_buffer_size=DEFAULT_READ_BUFFSIZE):
    """Read a line from a file
    @param date_format detected date log format regexp
    @param file_handle file_handle used to read line
    @param read_buffer_size max log line size
    @return : Return a tuple containing:
        the date/time in a format such as 'YYYYmmdd HH:MM:SS'
        the line itself

    The last colon and seconds are optional and
    not handled specially
    """
    try:
        line = file_handle.readline()
    except IOError as e_error:
        print(f"[ERROR] File I/O Error: {e_error}", file=sys.stderr)
        sys.exit(1)
    if line == '':
        debug_msg("EOF reached",0)
        sys.exit(1)
    if line[-1] == '\n':
        line = line.rstrip('\n')
    else:
        if len(line) >= read_buffer_size:
            print(f"Line length exceeds buffer size {read_buffer_size}b", file=sys.stderr)
        else:
            print("Missing newline", file=sys.stderr)
        sys.exit(1)
    debug_msg(f"get line: {line}",1)
    linedate = make_date_str(line, date_format)
    return (linedate, line)
# End function getdata()


def make_date_str(logline: str, date_format: str):
    """Convert a log date time information format to inernal timegrep format

    Args:
        logline (str): line containing normally a date time entry
        date_format (str): date format to parse the log file date time

    Returns:
        str: log file date time as internal date time format ( YYYYMMDD HH:MM:SS )
    """

    match_obj = re.match(date_format,logline)
    if match_obj is None:
        if DEBUG_LEVEL > 0:
            print(f"failed to match {date_format}", file=sys.stderr)
        return ''

    match_array = match_obj.groupdict()
    d_year = match_array['YEAR'] if 'YEAR' in match_array else CURRENT_YEAR
    d_month = match_array['MONTH'] if 'MONTH' in match_array else MONTH_LOOKUP[match_array['MONTH_NAME']]
    d_day = match_array['DAY'].zfill(2)
    d_hour = match_array['HOURS']
    d_min = match_array['MINUTES']
    d_sec = match_array['SECONDS'] if 'SECONDS' in match_array else '00'
    linedate = f"{d_year}{d_month}{d_day} {d_hour}:{d_min}:{d_sec}"

    return linedate
# End function make_date_str()

# Allow to detect log date-time format
def detect_date_format(file_handle: TextIO,
                       read_buffer_size=DEFAULT_READ_BUFFSIZE):
    """
    log_line contains the first line of the log file
    regexps are applied to try to detect the log format

    """
    # read first log line
    try:
        line = file_handle.readline()
    except IOError as io_e_error:
        print(f"[ERROR] File I/O Error: {io_e_error}", file=sys.stderr)
        sys.exit(1)
    if line == '':
        debug_msg("EOF reached",0)
        sys.exit(1)
    if line[-1] == '\n':
        line = line.rstrip('\n')
    else:
        if len(line) >= read_buffer_size:
            print("Line length exceeds buffer size", file=sys.stderr)
        else:
            print("Missing newline", file=sys.stderr)
        sys.exit(1)

    debug_msg("Analyzed line: " + line, 1)
    match_regexp = None
    for current_format in logformat_list:
        match_regexp = re.match(current_format['regexp'],line)
        if match_regexp is None:
            debug_msg("Log date format doesn't match " + current_format['name'] + " Log Format",1)
        else:
            debug_msg("Matching log format found : " + current_format['name'] + " Log format",1)
            match_regexp = current_format['regexp']
            break
    return match_regexp


CURRENT_DATETIME = datetime.now()
CURRENT_YEAR = CURRENT_DATETIME.year


parser = argparse.ArgumentParser(
    description=("Search a log file for a range of times occurring today.\n"
                "A date may be specified instead. Seconds are optional in time arguments."))

# parser.usage = "%prog [options] filename\n"


parser.add_argument("-d", "--date", action = "store", dest = "date",
                default = "",
                help = "Use the supplied date instead of today in the form YYYY-mm-dd")

parser.add_argument("", "--start-time", action = "store", dest = "start_time",
                default = "",
                help = "Display lines from start time in the form hh:mm[:ss]")

parser.add_argument("", "--end-time", action = "store", dest = "end_time",
                default = "",
                help = "Display line before end time in the form hh:mm[:ss]")

parser.add_argument("-l", "--long", action = "store_true", dest = "longout",
                default = False,
                help = "Span the longest possible time range.")

parser.add_argument("-s", "--short", action = "store_true", dest = "shortout",
                default = False,
                help = "Span the shortest possible time range.")

parser.add_argument("-D", "--debug", action = "store", dest = "debug",
                default = 0, type = "int",
                help = ('Output debugging information.'
                        '\t\t\t\t\tNone (default) = %default, Some = 1, More = 2'))

parser.add_argument("-L", "--log-regexp", action = "store", dest = "logregexp",
                default = None,
                help = "Add one or more log formats from a file.")

(options, args) = parser.parse_args()

if not 0 <= options.debug <= 2:
    parser.error("debug level out of range")
else:
    # 1 = print some debug output, 2 = print a little more, 0 = none
    DEBUG_LEVEL = int(options.debug)

if options.longout and options.shortout:
    parser.error("options -l and -s are mutually exclusive")

if options.date:
    selecteddate = options.date
else:
    selecteddate = CURRENT_DATETIME.strftime("%Y-%m-%d")

if not options.start_time and not options.end_time:
    parser.error("you need to specify at least a start time or an end time")

start_time = options.start_time if options.start_time else str("00:00:00")
end_time = options.end_time if options.end_time else str("23:59:59")
regexp_file = options.logregexp if options.logregexp else ""

if len(args) != 1:
    parser.error("Invalid number of arguments")

log_file = args[0]

# test for times to be properly formatted, allow hh:mm or hh:mm:ss
p = re.compile(r'(^[2][0-3]|[0-1][0-9]):[0-5][0-9](:[0-5][0-9])?$')

if not p.match(start_time) or not p.match(end_time):
    print("Invalid time specification")
    sys.exit(1)

def main():
    """
    main
    """

    rewind_offset = DEFAULT_REWIND_OFFSET
    max_iteration = DEFAULT_MAX_ITERATION

    # Determine Time Range
    # previousday = date.fromordinal(
    #     datetime.strptime(selecteddate, "%Y-%m-%d").toordinal()-1).strftime("%Y-%m-%d")
    selectedday = datetime.strptime(selecteddate, "%Y-%m-%d").strftime("%Y-%m-%d")

    searchdate  = datetime.strptime(selecteddate, "%Y-%m-%d").strftime("%Y%m%d")

    searchstart = searchdate + " " + start_time
    searchend   = searchdate + " " + end_time

    if searchend < searchstart:
        print("[ERROR] End time should be superior to start time", file=sys.stderr)
        sys.exit(1)

    # Set some initial values

    count   = int(0)
    log_file_size    = os.stat(log_file)[ST_SIZE]

    # Use bigger REWIND_OFFSET/MAX_ITERATION values for big log files ( > 2Go )
    if log_file_size > 2000000:
        rewind_offset = 100000
        max_iteration = 75000

    beginrange   = 0
    #timerange    = int(size * ( float(hourindex) / 24 ))
    timerange     = log_file_size / 2
    oldmidrange  = timerange
    endrange     = log_file_size
    linedate     = ''

    pos1 = pos2  = 0

    debug_msg(f"File: '{log_file}' Size: {log_file_size} Date: '{selectedday}' "
              f"Now: {CURRENT_DATETIME} Start: '{searchstart}' End: '{searchend}'",0)
    debug_msg(f"Timerange: '{timerange}' Endrange: {endrange} ",0)

    if regexp_file != "":
        try:
            with open(regexp_file, 'r', encoding='UTF8') as format_handle_f:
                for format_line in format_handle_f:
                    logformat_list.append(ast.literal_eval(format_line))
            format_handle_f.close()
        except IOError as io_e_error:
            print(f"[ERROR] Error while opening file {regexp_file}: {io_e_error}", file=sys.stderr)
            sys.exit(1)

    # Open log file and detect format. File stays open for binary search.
    try:
        f_handle = open(log_file, "r")
    except IOError as io_e_error:
        print(f"[ERROR] Error while opening file {log_file}: {io_e_error}", file=sys.stderr)
        sys.exit(1)

    detected_date_format = detect_date_format(f_handle)
    if detected_date_format is None:
        print("[ERROR]: Unable to detect date format or date format not supported", file=sys.stderr)
        sys.exit(1)

    # _suppress_keyboard_interrupt_message()

    # Seek using binary search algorithm
    # f_handle remains open throughout entire search and output loop
    # (see line 410 for explicit close)
    while pos1 != endrange and oldmidrange != 0 and linedate != searchstart:
        f_handle.seek(timerange)
        linedate, line = getdata(date_format=detected_date_format,
                                 file_handle=f_handle)    # sync to line ending
        pos1 = f_handle.tell()
        if timerange > 0:             # if not BOF, discard first read
            debug_msg(f"...partial: (len: {len(line)}) '{line}'",
                      msg_level=1)
            linedate, line = getdata(date_format=detected_date_format,
                                     file_handle=f_handle)

        pos2 = f_handle.tell()
        count += 1
        debug_msg(f"#{count} Beg: {beginrange} Mid: {timerange} End: {endrange} "
                  f"P1: {pos1} P2: {pos2} Current Timestamp: '{linedate}'")
        if  searchstart > linedate:
            beginrange = timerange
        else:
            endrange = timerange
        oldmidrange = timerange
        timerange = (beginrange + endrange) // 2
        if count > max_iteration:
            print(f"[ERROR]: Number of iteration exceed MAX_ITERATION {max_iteration}",
                  file=sys.stderr)
            sys.exit(1)

    debug_msg(f"...stopping: '{line}'",0)

    # Rewind a bit to make sure we didn't miss any
    seek = oldmidrange
    while linedate >= searchstart and seek > 0:
        if seek < rewind_offset:
            seek = 0
        else:
            seek = seek - rewind_offset
        debug_msg("...rewinding",0)
        f_handle.seek(seek)

        linedate, line = getdata(date_format=detected_date_format,
                                 file_handle=f_handle)
        debug_msg(f"...junk: '{line}'",0)

        linedate, line = getdata(date_format=detected_date_format,
                                 file_handle=f_handle)
        debug_msg(f"...comparing: '{linedate}'",0)

    # Scan forward
    while linedate < searchstart:
        debug_msg(f"...skipping: '{linedate}'",0)
        linedate, line = getdata(date_format=detected_date_format,
                                 file_handle=f_handle)

    debug_msg(f"...found: '{line}'",0)

    debug_msg((f"Beg: {beginrange} Mid: {timerange} End: {endrange} "
               f"P1: {pos1} P2: {pos2} Timestamp: '{linedate}'"),0)

    # Now that the preliminaries are out of the way, we just loop,
    #     reading lines and printing them until they are
    #     beyond the end of the range we want

    while linedate <= searchend:
        print(line)
        linedate, line = getdata(date_format=detected_date_format,
                                  file_handle=f_handle)

    debug_msg(f"Start: '{searchstart}' End: '{searchend}'",0)
    # Explicitly close file (opened at line 332 with explicit open(),
    # not a context manager, so close must be called explicitly)
    f_handle.close()

if __name__ == "__main__":
    main()
